# Application Port and Host
APP_PORT=8080
APP_HOST=0.0.0.0

# Storage Locations (Inside Container)
DOWNLOAD_DIR=/data/downloads
TEMP_DIR=/data/temp

# Concurrency Limits
MAX_CONCURRENT_DOWNLOADS=2

# Retention & Automated Cleanup (in seconds, 0 = disabled)
DOWNLOAD_RETENTION=86400
TEMP_RETENTION=3600

# yt-dlp Auto-Update Settings
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_INTERVAL=86400
YTDLP_UPDATE_CHANNEL=stable

# Safety Limits
MAX_DOWNLOAD_SIZE=10G
DOWNLOAD_TIMEOUT=3600
ANALYSIS_TIMEOUT=45

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
